#!/bin/bash
set -euxo pipefail

dnf update -y

# Application dependencies + tools
dnf install -y \
  httpd \
  php \
  php-mysqlnd \
  php-cli \
  jq \
  unzip \
  mariadb105 \
  curl

# Install AWS CLI if it is not already available.
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
    -o /tmp/awscliv2.zip

  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

# Make sure SSM Agent exists.
# AWS AL2023 AMIs commonly include it, but the minimal AMI may not.
if ! command -v amazon-ssm-agent >/dev/null 2>&1 && \
   [ ! -x /usr/bin/amazon-ssm-agent ]; then

  dnf install -y \
    "https://s3.${aws_region}.amazonaws.com/amazon-ssm-${aws_region}/latest/linux_amd64/amazon-ssm-agent.rpm"
fi

# Start SSM Agent BEFORE doing the application bootstrap.
systemctl enable amazon-ssm-agent
systemctl start amazon-ssm-agent

# Pull DB connection details from Secrets Manager
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "${secret_arn}" \
  --region "${aws_region}" \
  --query SecretString \
  --output text)

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .password)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)

cat <<EOF > /etc/httpd/conf.d/assignment-env.conf
SetEnv DB_HOST "$DB_HOST"
SetEnv DB_USER "$DB_USER"
SetEnv DB_PASS "$DB_PASS"
SetEnv DB_NAME "$DB_NAME"
SetEnv AWS_S3_BUCKET "${artifact_bucket}"
SetEnv AWS_S3_REGION "${aws_region}"
EOF

mkdir -p /var/www/html

# Self-healing deploy
if aws s3api head-object \
    --bucket "${artifact_bucket}" \
    --key "${artifact_key}" \
    --region "${aws_region}" >/dev/null 2>&1; then

  aws s3 cp \
    "s3://${artifact_bucket}/${artifact_key}" \
    /tmp/assignment-app.zip \
    --region "${aws_region}"

  rm -rf /var/www/html/*
  unzip -o /tmp/assignment-app.zip -d /var/www/html

else

  echo "<?php http_response_code(200); echo 'assignment-event-ticketing: bootstrapped, waiting for first deploy.';" \
    > /var/www/html/index.php

  echo "<?php http_response_code(200); header('Content-Type: text/plain'); echo 'ok';" \
    > /var/www/html/healthz.php

fi

systemctl enable httpd
systemctl restart httpd